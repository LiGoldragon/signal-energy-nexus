Signal
[ crate:[ Provider Reading Level Reset Pace ] ]           ; imports the Energy Nexus vocabulary, ethos/library.ethos
[ Read.Provider                                           ; the latest reading, read first when older than the last turn end on it
  Subscribe
  Redeem.Provider ]
[ Read.{ Reading Vector<Pace> }                           ; ordinary Energy Nexus outputs, the n-th answering the n-th input
  Subscribed
  Redeemed.Reset
  Changed.{ Provider Level Reading }                      ; one pushed level change, answering no input
  Refused ]                                               ; any input's refusal
[ Refused.[ ProviderDown.Provider                         ; typed ordinary refusals
            NoReset
            RuleRefused.String ]
  Caller.{ ProcessId.Integer UserId.Integer }             ; local envelope types
  Call.{ Caller Input } ]                                 ; carries the peer caller and the ordinary input
