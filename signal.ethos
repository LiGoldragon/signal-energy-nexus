Signal
[ energy:[ Provider Reading Level Reset ResetId Pace ] ]    ; imports Energy Nexus vocabulary
[ Call.{ Caller Input.[ Read.Provider                       ; the latest reading, read first when older than the last turn end on it
                        Subscribe
                        Redeem.Provider ] } ]
[ Read.{ Reading Vector<Pace> }                            ; the reading, and the pace of each window in useful hours
  Subscribed
  Changed.{ Provider Level Reading }                       ; one pushed level change
  Redeemed.Reset
  Refused.[ ProviderDown.Provider                          ; typed ordinary refusals
            NoReset
            RuleRefused.String ] ]
[ Caller.{ ProcessId.Integer UserId.Integer } ]            ; local envelope types
